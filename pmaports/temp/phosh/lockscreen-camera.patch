+    gtk_container_foreach (GTK_CONTAINER (priv->keypad), set_digit_height,
+                           GINT_TO_POINTER (priv->unlock_wide ? 48 :
+                                            height < LOCKSCREEN_TIGHT_DISPLAY ? 30 :
+                                            height < LOCKSCREEN_TIGHT_DISPLAY + 100 ? 40 : 48));
+  }
+
   PHOSH_LAYER_SURFACE_CLASS (phosh_lockscreen_parent_class)->configured (layer_surface);
 }
 
