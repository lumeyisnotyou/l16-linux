#!/usr/bin/env python3
# light-lfc-strip-volume: the touch strip as volume keys, except while an app wants the strip
# for itself (the camera apps use it for zoom). A swipe of a tenth of the strip is one key
# press; the keys come from a uinput device, so the desktop handles them as it does the
# volume button (its on-screen display included).
#
# Claiming the strip: any app can ask to keep it, whenever it likes, by putting a file named for
# the app in l16-strip/ in its runtime directory ($XDG_RUNTIME_DIR/l16-strip/<name>) that holds
# its PID, and removing the file when it no longer wants the strip. The volume keys are left alone
# for as long as a claim exists whose process is still running (a claim that outlived a crashed
# app doesn't count). The check is made when a touch starts, so a touch that began before a claim
# finishes as volume, and one that began after it is the app's.
#   echo $$ > "$XDG_RUNTIME_DIR/l16-strip/my-app"     # claim
#   rm "$XDG_RUNTIME_DIR/l16-strip/my-app"            # let go
# Older camera apps mark themselves with l16-camera.front instead; that still counts while a
# process of the camera apps (CAMERA_COMMS) runs.
import fcntl
import glob
import os
import struct
import time

EV_SYN, EV_KEY, EV_ABS = 0, 1, 3
SYN_REPORT, ABS_X, BTN_TOUCH = 0, 0, 330
KEY_VOLUMEDOWN, KEY_VOLUMEUP = 114, 115
STEP = 768 // 10

# every user's claims (the service runs as root)
CLAIMS = "/run/user/*/l16-strip/*"
# the camera apps whose l16-camera.front marker counts as a claim
CAMERA_COMMS = ("l16-camera", "nebula")

UI_DEV_CREATE = 0x5501			# _IO('U', 1)
UI_DEV_SETUP = 0x405c5503		# _IOW('U', 3, struct uinput_setup)
UI_SET_EVBIT = 0x40045564		# _IOW('U', 100, int)
UI_SET_KEYBIT = 0x40045565		# _IOW('U', 101, int)
BUS_VIRTUAL = 6


def strip():
	for name in glob.glob("/sys/class/input/event*/device/name"):
		if open(name).read().strip() == "Light L16 touch strip":
			return "/dev/input/" + name.split("/")[4]
	return None


def camera_running():
	for comm in glob.glob("/proc/[0-9]*/comm"):
		try:
			if open(comm).read().strip() in CAMERA_COMMS:
				return True
		except OSError:
			pass
	return False


def camera_in_front():
	return bool(glob.glob("/run/user/*/l16-camera.front")) and camera_running()


def pid_alive(pid):
	if pid <= 0:
		return False
	try:
		os.kill(pid, 0)
	except ProcessLookupError:
		return False
	except PermissionError:
		pass	# it exists, it's just not ours
	return True


def claimed():
	"""Does an app want the strip? (see the claims at the top)"""
	for path in glob.glob(CLAIMS):
		try:
			with open(path) as f:
				pid = int(f.read().split()[0])
		except (OSError, ValueError, IndexError):
			continue
		if pid_alive(pid):
			return True
	return camera_in_front()


def keyboard():
	ui = open("/dev/uinput", "r+b", buffering=0)	# (r+: never create it)
	fcntl.ioctl(ui, UI_SET_EVBIT, EV_KEY)
	for key in (KEY_VOLUMEDOWN, KEY_VOLUMEUP):
		fcntl.ioctl(ui, UI_SET_KEYBIT, key)
	# struct uinput_setup: input_id {bustype, vendor, product, version}, name[80], ff_effects_max
	setup = struct.pack("HHHH80sI", BUS_VIRTUAL, 0, 0, 1, b"Light L16 touch strip volume", 0)
	fcntl.ioctl(ui, UI_DEV_SETUP, setup)
	fcntl.ioctl(ui, UI_DEV_CREATE)
	return ui


def press(ui, key, times):
	for _ in range(times):
		for value in (1, 0):
			ui.write(struct.pack("llHHi", 0, 0, EV_KEY, key, value))
			ui.write(struct.pack("llHHi", 0, 0, EV_SYN, SYN_REPORT, 0))


def main():
	path = strip()
	while path is None:
		time.sleep(5)
		path = strip()
	ui = keyboard()
	with open(path, "rb") as f:
		anchor = None
		ignore = False
		while True:
			_, _, typ, code, value = struct.unpack("llHHi", f.read(24))
			if typ == EV_ABS and code == ABS_X:
				if anchor is None:
					# a new touch (its position comes before the touch-down)
					anchor = value
					ignore = claimed()
				elif not ignore and abs(value - anchor) >= STEP:
					steps = abs(value - anchor) // STEP
					press(ui, KEY_VOLUMEUP if value > anchor else KEY_VOLUMEDOWN, steps)
					anchor += steps * STEP if value > anchor else -steps * STEP
			elif typ == EV_KEY and code == BTN_TOUCH and value == 0:
				anchor = None


if __name__ == "__main__":
	main()
